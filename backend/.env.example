# Copy to .env and fill in.
PORT=4100
# Signs the login cookie. If left empty, one is generated and kept in data/jwt-secret.
JWT_SECRET=
# Where the numbers come from (the Python calc-service from the stock project).
CALC_SERVICE_URL=http://localhost:8000
# Where users, statements and the day's analysis are kept (defaults to backend/data).
DATA_DIR=
