# Copy to a file named .env in this folder; docker compose reads it by itself.

# Port the app is reachable on, on this computer.
PGO_PORT=4100

# Signs the login cookie. Leave empty to have one generated and kept with the data.
JWT_SECRET=

# Where the calc-service runs. The default is this computer's port 8000.
CALC_SERVICE_URL=http://host.docker.internal:8000
