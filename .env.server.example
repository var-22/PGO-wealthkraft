# Copy to a file named .env on the server, next to docker-compose.server.yml.

# The address customers will open. It must point at this server.
# No domain yet? Use the server's IP with dashes plus .sslip.io, for example 203-0-113-10.sslip.io
PGO_DOMAIN=

# Signs the login cookie. Any long random text; keep it secret and do not change it later
# (changing it signs everyone out). One way to make one:  openssl rand -hex 48
JWT_SECRET=

# Where the calc-service runs. Leave as is when it runs on this same server on port 8000.
CALC_SERVICE_URL=http://host.docker.internal:8000
